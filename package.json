{
  "name": "@loipv/nestjs-kafka",
  "version": "1.3.0",
  "description": "A production-ready NestJS module for Kafka client and consumer functionality built on top of confluent-kafka-javascript",
  "author": "loipv792@gmail.com",
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loipv/nestjs-kafka.git"
  },
  "homepage": "https://github.com/loipv/nestjs-kafka#readme",
  "bugs": {
    "url": "https://github.com/loipv/nestjs-kafka/issues"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nestjs",
    "kafka",
    "confluent",
    "confluent-kafka",
    "librdkafka",
    "consumer",
    "producer",
    "batch",
    "dlq",
    "dead-letter-queue",
    "idempotency",
    "microservices",
    "message-queue",
    "event-driven",
    "opentelemetry",
    "tracing",
    "observability"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,lib,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "prepublishOnly": "npm run build && npm run check:pack && npm run check:pkg && npm run typecheck && npm test",
    "check:pack": "node scripts/check-pack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:check": "eslint \"{lib,test}/**/*.ts\"",
    "check:pkg": "publint && attw --pack . --profile node16",
    "test:smoke": "node scripts/smoke.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@nestjs/terminus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "lib",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/__mocks__/**",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 89,
        "branches": 77,
        "functions": 94,
        "lines": 89
      }
    },
    "testEnvironment": "node"
  }
}
